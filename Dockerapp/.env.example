# .env.example — Example environment variables for local development
# Copy this file to .env and edit values as needed. DO NOT store real secrets here.

# Flask settings
FLASK_APP=app.py
FLASK_ENV=development

# App-specific variables (example values)
BG_COLOR=#ffffff
FONT_COLOR=#000000
CUSTOM_HEADER=Local Development Header
CUSTOM_PHOTO=https://example.com/sample-photo.jpg
